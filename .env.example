# Copy to .env and supply real values. Never commit .env.
DATABASE_URL=postgresql://easyq_backend:CHANGE_ME@host.docker.internal:5432/easyq
AUTH_DATABASE_URL=postgresql://easyq_auth:CHANGE_ME@host.docker.internal:5432/easyq
BACKEND_DATABASE_URL=postgresql://easyq_backend:CHANGE_ME@host.docker.internal:5432/easyq
WORKER_DATABASE_URL=postgresql://easyq_worker:CHANGE_ME@host.docker.internal:5432/easyq
PUBLIC_ORIGIN=https://easyq.example.com
COOKIE_SECURE=true
# Generate independently: secrets.token_urlsafe(48)
CODE_HMAC_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
INTERNAL_SERVICE_KEY=REPLACE_WITH_INDEPENDENT_BACKEND_KEY_32_CHARACTERS
WORKER_SERVICE_KEY=REPLACE_WITH_INDEPENDENT_WORKER_KEY_32_CHARACTERS
# Generate: cryptography.fernet.Fernet.generate_key().decode()
DELIVERY_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
AUTH_BASE_URL=http://auth:8000
# Proxies trusted for X-Forwarded-For (client IP for rate limits). Default * is safe only
# while auth/backend publish no host port; narrow to Caddy's address if they do.
FORWARDED_ALLOW_IPS=*
STORAGE_BACKEND=s3
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
# Local development only: STORAGE_BACKEND=local, shared OBJECT_ROOT for backend/worker
OBJECT_ROOT=/app/var/objects
# Use the actual Gemini Embedding 2 model ID and matching batchEmbedContents endpoint
# agreed with the AI team. An absent provider is a failed/retried job, never fake READY.
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Real-time STT (Gemini 3.5 Transcribe-Live, 6.2.5) model ID and key for the google-genai Live API.
# Without them audio.start is refused with STT_UNAVAILABLE; audio is never stored.
STT_MODEL=
STT_API_KEY=
# Conservative upper USD bound for ONE batch (at most 32 slide chunks of up to 400 tokens).
# Set using the provider's contracted price. With a hard cap and unknown price, jobs are HELD.
EMBEDDING_MAX_BATCH_COST_USD=
EMBEDDING_PRICE_VERSION=
# Set only after a compatible evaluation reference import is verified.
EVAL_REFERENCE_VERSION=
EVAL_REFERENCE_RETRIEVAL_VERSION=
# Slide chunk token counter for retrieval.chunk_slides. Default downloads BAAI/bge-reranker-v2-m3 tokenizer.json
# from Hugging Face on the first INGEST; set a local tokenizer.json path for offline workers.
CHUNK_TOKENIZER=BAAI/bge-reranker-v2-m3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Implicit TLS (port 465). Gmail 587 uses STARTTLS above, so keep false.
SMTP_SSL_TLS=false
# Claude (worker: QA answers, LLM_ONLY judgment, summary notes). Never commit a real key.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_PROMPT_VERSION=llm-only-v1
# LLM_ONLY answer threshold (0-100) used until a serving config (API-62) sets one.
LLM_ONLY_THRESHOLD=70
# Contracted prices; with the budget hard cap on and no price, LLM calls are held.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=
LLM_PRICE_VERSION=
# Training server (7.4) through the SSH tunnel on the Docker bridge host, port 9000. backend and worker only.
TRAINING_API_BASE_URL=
TRAINING_API_KEY=
# Record/replay for low-cost tests: live (default) | record | replay. The store holds lecture text and answers;
# keep it out of git (var/ is ignored). replay never calls a provider: a request not recorded is an error.
PROVIDER_MODE=live
PROVIDER_STORE=./var/provider-store
PROVIDER_STT_RECORDING=default
